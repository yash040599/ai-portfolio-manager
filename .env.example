# ────────────────────────────────────────────────────────────
# Required — Zerodha Kite Connect API
# ────────────────────────────────────────────────────────────
# Get these from https://kite.trade/ → Apps → Create new app.
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# ────────────────────────────────────────────────────────────
# Required — Anthropic Claude API (only used when running with --ai)
# ────────────────────────────────────────────────────────────
# Free to leave blank if you only ever use the default --noai path
# (pure rule-based; no Claude calls). Get a key from
# https://console.anthropic.com/.
CLAUDE_API_KEY=your_claude_api_key_here

# ────────────────────────────────────────────────────────────
# Optional — programmatic Kite login
# ────────────────────────────────────────────────────────────
# Leave blank to use the manual browser login flow at startup.
# When the bot starts it will pick the most automated flow your
# .env allows and fall back automatically.
#
#   USER_ID + PASSWORD only         → ASSISTED  (you type the 6-digit
#                                                TOTP at the prompt)
#   USER_ID + PASSWORD + TOTP_SECRET → AUTO     (zero-touch; the seed
#                                                lets the bot compute
#                                                the 6-digit code itself
#                                                — single-factor risk;
#                                                see README §5.4)
#
# TOTP secret is the base32 string Kite shows you ONCE when enabling
# external 2FA (https://console.zerodha.com/account/personal/password).
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# ────────────────────────────────────────────────────────────
# Optional — private data backup repo (scripts/backup_data.py)
# ────────────────────────────────────────────────────────────
# scripts/backup_data.py syncs runtime data (data/, reports/, logs/,
# copilot/) to a SEPARATE *private* GitHub repo so it survives
# reinstalls and is shareable across machines (e.g. dev laptop ↔
# trading VM). The data repo holds your trade ledger, candle cache,
# and per-day reports — keep it private.
#
# Create an EMPTY private repo on GitHub, then set ONE or BOTH of
# these (HTTPS for desktops authed via `gh auth login`, SSH for
# headless VMs with an SSH key on the GitHub account):
BACKUP_REPO_URL_HTTPS=
BACKUP_REPO_URL_SSH=

# ────────────────────────────────────────────────────────────
# Optional — private backtest/replay data repo
# ────────────────────────────────────────────────────────────
# This is separate from the operational backup repo above. It stores
# normalized historical replay datasets and is cloned into the local
# gitignored backtest_data/ path by scripts/shared/sync_backtest_data.py.
# Use HTTPS on the dev machine and SSH on the Linux trading VM.
BACKTEST_DATA_REPO_URL_HTTPS=
BACKTEST_DATA_REPO_URL_SSH=
BACKTEST_DATA_PATH=backtest_data
